# Copy to .env (gitignored) for local development, or set these as real environment variables.
DB_URL=jdbc:postgresql://localhost:5432/codecanvas
DB_USERNAME=codecanvas
DB_PASSWORD=change-me

# Optional: email for "Forgot password?" links. Leave SPRING_MAIL_HOST unset locally to print the link in the log instead.
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-smtp-login
# SPRING_MAIL_PASSWORD=your-smtp-key
# MAIL_FROM=TraceTables <you@example.com>
# APP_BASE_URL=http://localhost:8080
